    aircraft_name,
    departure_city_code,
    departure_city_name,
    departure_country_code,
    departure_country_name,
    arrival_city_code,
    arrival_city_name,
    arrival_country_code,
    arrival_country_name
from "postgres"."public"."operational_flight_legs"
  );
